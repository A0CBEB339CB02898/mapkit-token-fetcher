# Isolated offline regression image; never copies credentials or auth state.
FROM mcr.microsoft.com/playwright:v1.57.0-noble
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY public ./public
COPY tests ./tests
ENV DATA_DIR=/tmp/mapkit-test-data
CMD ["sh", "-c", "npm run typecheck && npm run build && npm test && npm run test:browser"]
